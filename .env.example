# ─────────────────────────────────────────────────────────────
# NotiAI 백엔드 환경변수 예시
# 복사해서 .env 로 사용하세요. (.env 는 git 에 올라가지 않습니다)
# ─────────────────────────────────────────────────────────────

# DB — 기본은 로컬 SQLite 파일. 배포 시 PostgreSQL 예: postgresql+psycopg://user:pw@host:5432/notiai
DATABASE_URL=sqlite:///./notiai.db

# 세션 쿠키 서명 키 (배포 시 반드시 긴 랜덤 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-string

# 프론트 주소 (CORS 허용 목록, 쉼표 구분) / 로그인 후 돌아갈 주소
CORS_ORIGINS=http://localhost:5173,https://notiai.pages.dev
FRONTEND_URL=http://localhost:5173

# true: 로그인 없이 "개발용 사용자"로 동작 (Google OAuth 설정 전 프론트 연결 테스트용)
# 배포 시 false
DEV_LOGIN=true

# 프론트와 백엔드 도메인이 다른 https 배포에서는 true (쿠키 SameSite=None; Secure)
COOKIE_SECURE=false

# Google OAuth (Google Cloud Console → OAuth 클라이언트 ID, 웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OpenAI — AI 플래너 + (EXTRACTOR=gpt 일 때) 일정 추출
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=800

# 일정 추출기: stub | gpt | model_api
#  - stub      : LLM 없이 제목만 저장 (전부 needs_review). 키 없이 파이프라인 테스트용
#  - gpt       : OpenAI 로 5필드 추출 (모델 완성 전 임시)
#  - model_api : 모델 팀이 띄운 추론 서버(MODEL_API_URL) 호출
EXTRACTOR=stub
EXTRACT_MODEL=gpt-4o-mini
MODEL_API_URL=

# capstonenotiai/model repo 로컬 경로 (크롤러 실행 + SYSTEM_PROMPT/postprocess 재사용)
MODEL_REPO_PATH=

# 정기 수집 (서버 실행 중 cron 으로 크롤 → 추출)
CRAWL_ENABLED=false
CRAWL_CRON=0 9 * * *
CRAWL_MAX_PAGES=2
